NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional AI tutor. Disabled by default. All variables below are server-only.
AI_TUTOR_ENABLED=false
OPENAI_API_KEY=
# Choose a currently supported Responses/Structured Outputs model before enabling.
# Official docs checked 2026-10-24: gpt-6-luna is a cost-sensitive option.
OPENAI_MODEL=
# Supabase secret/service-role key: trusted AI writes only. Never use NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
# Optional current model rates; omit to show token counts without a dollar estimate.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Billing stays disabled unless explicitly set to test. Live mode is not implemented.
BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ESEWA_TEST_PRODUCT_CODE=
ESEWA_TEST_SECRET=
# Sandbox merchant key from test-admin.khalti.com, never a production merchant key.
KHALTI_SANDBOX_SECRET=
# Launch controls. These flags are release gates, not substitutes for owner approval.
APP_ENV=development
LAUNCH_RELEASE_APPROVED=false
LAUNCH_INDEXING_APPROVED=false
# Optional first-party aggregate browser analytics and sanitized monitoring.
ANALYTICS_ENABLED=false
OPERATIONS_ENABLED=false
# Generate a random server-only value of at least 32 characters when enabling workers.
OPERATIONS_SECRET=
# No provider has been approved or configured. Automated tests never send mail.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER_APPROVED=false
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
# Task 13: protected scheduled publishing remains off until an owner-approved job exists.
CMS_SCHEDULE_ENABLED=false
# Production canonical domain: https://nihonpath.org. Configure only for an approved release.
